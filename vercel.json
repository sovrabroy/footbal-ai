{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/sync-fixtures",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/cron/update-results",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/train-weights",
      "schedule": "0 2 * * *"
    }
  ]
}
