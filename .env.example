# Supabase & PostgreSQL Database Connection
# Option A: Supabase Transaction Pooler (Recommended for Vercel Serverless Functions)
# e.g., postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Option B: Direct Supabase Connection (Port 5432) or Supabase REST / Client Credentials
# SUPABASE_DATABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Random CRON Secret for securing scheduled synchronization routes (/api/cron/*)
# Use Bearer header: `Authorization: Bearer <CRON_SECRET>` or query param `?key=<CRON_SECRET>`
CRON_SECRET="gp_cron_7f8a92d4e1b5c8309a6f1d2e84bc9103"

# Football API Configuration (Server-side secret, never expose to browser)
FOOTBALL_API_PROVIDER="api-football"
FOOTBALL_API_KEY=""
FOOTBALL_API_BASE_URL="https://v3.football.api-sports.io"

# Default Odds preference (Client-side safe public variable)
NEXT_PUBLIC_DEFAULT_ODDS="1"
NEXT_PUBLIC_DEFAULT_ODDS_FORMAT="decimal"

# Gemini AI API Key for quantitative scouting report generation (Server-side only)
